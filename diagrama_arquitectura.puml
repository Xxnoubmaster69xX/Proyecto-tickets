@startuml
skinparam componentStyle uml2

node "Frontend (Desktop GUI)" {
    component "PyQt6 Views" as UI
    component "Controllers" as Controllers
    
    UI <--> Controllers : EventBus / Metodos directos
}

node "Backend (Lógica de Negocio)" {
    component "Models (Dataclasses)" as Models
    component "Repositories Pattern" as Repos
    
    Controllers --> Models : Validacion de Dominio
    Controllers --> Repos : CRUD / Consultas
}

database "SQLite Database" {
    component "ticket_turno.db" as DB
}

Repos --> DB : SQL Queries
@enduml
